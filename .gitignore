# ---- Data ----
# WRDS data (CRSP, Compustat, IBES, short interest, 13F) is licensed: never commit it.
# Only the small JSON / CSV descriptions of the processed panel are kept.
data/*
!data/processed/
data/processed/*
!data/processed/feature_groups.json
!data/processed/industry_mapping.json
!data/processed/split_dates.json
!data/processed/preprocessing_report.csv
!data/processed/feature_selection_table.csv
!data/processed/cost_inputs_report.csv
!data/processed/cost_inputs_spread_sources.csv
!data/processed/cost_inputs_settings.json

# ---- Results ----
# Tables, figures and the trained checkpoint are committed. Prediction files are
# not (one row per stock-month, ~120 MB; regenerated by src/models/mlp_model.py).
results/**/predictions.parquet
# walk-forward working files: one prediction file and five networks per year (regenerated
# by src/models/walk_forward.py); the summaries in results/walk_forward/ are committed
results/walk_forward/*/years/
results/walk_forward/*/models/
results/walk_forward_quick/
results/quick_*/

# ---- Python ----
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# ---- Virtual environments ----
.venv/
venv/
env/

# ---- OS / editors ----
.DS_Store
.Rhistory
.vscode/
.idea/
*.swp

# ---- Logs ----
*.log
